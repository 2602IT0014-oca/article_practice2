<h1>投稿編集</h1>

<%= form_with model: @article, local: true do |f| %>
  <div class="margin-bottom-15">
    <%= f.label :title, "タイトル" %><br>
    <%= f.text_field :title, class: "width-300" %>
  </div>

  <div class="margin-bottom-15">
    <%= f.label :content, "投稿内容" %><br>
    <%= f.text_area :content, rows: 5, class: "width-300" %>
  </div>

  <div class="flex-gap-10">
    <%= f.submit "更新する", class: "btn-blue" %>
    <%= link_to "詳細へ戻る", article_path(@article), class: "btn-gray" %>
  </div>
<% end %>
